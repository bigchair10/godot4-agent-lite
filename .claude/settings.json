{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(godot --headless:*)"
    ],
    "deny": [
      "Read(./.godot/**)",
      "Edit(./.godot/**)",
      "Read(./**/*.import)",
      "Edit(./**/*.import)",
      "Read(./**/*.uid)",
      "Edit(./**/*.uid)",
      "Read(./builds/**)",
      "Read(./export/**)"
    ]
  }
}
